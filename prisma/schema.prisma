// Prisma 스키마 — 실버노트 세계 최고 시니어 플랫폼
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model CareCenter {
  id          String   @id @default(cuid())
  name        String
  address     String
  phone       String?
  email       String?
  description String?  @db.Text
  logoUrl     String?
  homepageSlug String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members         User[]
  residents       Resident[]
  posts           Post[]
  products        Product[]
  dailyReports    DailyReport[]
  menuPlans       MenuPlan[]
  announcements   Announcement[]
  handoverNotes   HandoverNote[]
  auditLogs       AuditLog[]
  carePlans       CarePlan[]

  @@index([name])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  name         String
  phone        String?
  role         UserRole  @default(FAMILY)
  avatarUrl    String?
  pinHash      String?
  staffMode    Boolean   @default(false)
  fontScale    Int       @default(1) // 1=normal 2=large 3=xlarge

  careCenterId String?
  careCenter   CareCenter? @relation(fields: [careCenterId], references: [id])

  accounts           Account[]
  sessions           Session[]
  posts              Post[]
  comments           Comment[]
  orders             Order[]
  medicalRecords     MedicalRecord[]
  notifications      Notification[]
  residentFamilies   ResidentFamily[]
  dailyReports       DailyReport[]
  reportReactions    ReportReaction[]
  visitRequests      VisitRequest[]
  supplyRequests     SupplyRequest[]
  handoverNotes      HandoverNote[]
  auditLogs          AuditLog[]
  carePlans          CarePlan[]
  medicationLogs     MedicationLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([careCenterId])
}

enum UserRole {
  FAMILY
  CAREGIVER // staff
  ADMIN     // center admin (legacy + elevated)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resident {
  id          String   @id @default(cuid())
  name        String
  birthDate   DateTime?
  gender      String?
  roomNumber  String?
  photoUrl    String?
  notes       String?  @db.Text
  statusChip  MoodChip @default(OK)

  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])

  posts              Post[]
  medicalRecords     MedicalRecord[]
  orders             Order[]
  families           ResidentFamily[]
  dailyReports       DailyReport[]
  visitRequests      VisitRequest[]
  supplyRequests     SupplyRequest[]
  emergencyContacts  EmergencyContact[]
  carePlans          CarePlan[]
  medications        MedicationSchedule[]
  vitalSigns         VitalSign[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([careCenterId])
}

enum MoodChip {
  GOOD
  OK
  CAUTION
}

model ResidentFamily {
  id           String   @id @default(cuid())
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relationship String
  familyRole   FamilyRole @default(VIEWER)
  isApproved   Boolean  @default(false)
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([residentId, userId])
  @@index([residentId])
  @@index([userId])
}

enum FamilyRole {
  PRIMARY
  VIEWER
}

model EmergencyContact {
  id         String   @id @default(cuid())
  residentId String
  resident   Resident @relation(fields: [residentId], references: [id], onDelete: Cascade)
  name       String
  phone      String
  relation   String?
  priority   Int      @default(1)
  createdAt  DateTime @default(now())

  @@index([residentId])
}

model Notification {
  id          String   @id @default(cuid())
  type        NotificationType
  title       String
  content     String?  @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedId   String?
  relatedType String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

enum NotificationType {
  PostCreated
  CommentCreated
  PostLiked
  MedicalRecordCreated
  MedicalRecordUpdated
  OrderCreated
  OrderStatusChanged
  FamilyRequest
  FamilyApproved
  FamilyRejected
  Announcement
  DailyReport
  VisitRequest
  SupplyRequest
  Other
}

// 1:1 알림장
model DailyReport {
  id           String    @id @default(cuid())
  content      String?   @db.Text
  images       String?
  moodChip     MoodChip  @default(OK)
  chips        String?   // JSON: meal, sleep, walk, etc.
  isDraft      Boolean   @default(false)
  scheduledAt  DateTime?
  publishedAt  DateTime?
  readAt       DateTime?
  kakaoSentAt  DateTime?
  magicToken   String?   @unique

  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id])
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])

  reactions    ReportReaction[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([careCenterId])
  @@index([residentId])
  @@index([authorId])
  @@index([publishedAt])
}

model ReportReaction {
  id        String   @id @default(cuid())
  type      String   // heart | thanks | voice
  note      String?
  reportId  String
  report    DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([reportId, userId, type])
  @@index([reportId])
}

model MenuPlan {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  breakfast    String?
  lunch        String?
  dinner       String?
  snack        String?
  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([careCenterId, date])
  @@index([careCenterId])
}

model Announcement {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  images       String?
  isUrgent     Boolean  @default(false)
  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])
  authorId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([careCenterId])
}

model VisitRequest {
  id          String   @id @default(cuid())
  status      RequestStatus @default(Pending)
  visitAt     DateTime
  visitors    String?
  notes       String?  @db.Text
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([userId])
}

model SupplyRequest {
  id          String   @id @default(cuid())
  status      RequestStatus @default(Pending)
  itemName    String
  quantity    Int      @default(1)
  notes       String?
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([userId])
}

enum RequestStatus {
  Pending
  Approved
  Rejected
  Completed
  Cancelled
}

model HandoverNote {
  id           String   @id @default(cuid())
  content      String   @db.Text
  shift        String?
  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())

  @@index([careCenterId])
}

model AuditLog {
  id           String   @id @default(cuid())
  action       String
  entityType   String?
  entityId     String?
  meta         String?  @db.Text
  careCenterId String?
  careCenter   CareCenter? @relation(fields: [careCenterId], references: [id])
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())

  @@index([careCenterId])
  @@index([userId])
  @@index([createdAt])
}

model CarePlan {
  id           String   @id @default(cuid())
  title        String
  content      String   @db.Text
  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])
  residentId   String
  resident     Resident @relation(fields: [residentId], references: [id])
  authorId     String
  author       User     @relation(fields: [authorId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([residentId])
}

model MedicationSchedule {
  id          String   @id @default(cuid())
  name        String
  dosage      String?
  schedule    String?
  notes       String?
  active      Boolean  @default(true)
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])
  logs        MedicationLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
}

model MedicationLog {
  id           String   @id @default(cuid())
  administered Boolean  @default(true)
  note         String?
  scheduleId   String
  schedule     MedicationSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  givenById    String
  givenBy      User     @relation(fields: [givenById], references: [id])
  givenAt      DateTime @default(now())

  @@index([scheduleId])
}

model VitalSign {
  id          String   @id @default(cuid())
  type        String
  value       String
  unit        String?
  recordedAt  DateTime @default(now())
  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])

  @@index([residentId])
  @@index([recordedAt])
}

model Post {
  id          String   @id @default(cuid())
  title       String?
  content     String?  @db.Text
  images      String?

  careCenterId String
  careCenter   CareCenter @relation(fields: [careCenterId], references: [id])

  residentId   String?
  resident     Resident? @relation(fields: [residentId], references: [id])

  authorId     String
  author       User     @relation(fields: [authorId], references: [id])

  category     PostCategory @default(Daily)

  comments     Comment[]
  likes        PostLike[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([careCenterId])
  @@index([authorId])
  @@index([residentId])
}

enum PostCategory {
  Daily
  Medical
  Event
  Announcement
  Album
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([postId])
}

model MedicalRecord {
  id          String   @id @default(cuid())
  title       String
  content     String   @db.Text
  recordDate  DateTime
  category    MedicalCategory
  plainExplain String? @db.Text

  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])

  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])

  attachments String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([residentId])
  @@index([createdById])
  @@index([recordDate])
}

enum MedicalCategory {
  Treatment
  Medication
  Exam
  Symptom
  Other
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Int
  imageUrl    String?
  stock       Int      @default(0)
  category    ProductCategory

  careCenterId String?
  careCenter   CareCenter? @relation(fields: [careCenterId], references: [id])

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([careCenterId])
  @@index([category])
}

enum ProductCategory {
  Daily
  Food
  Medical
  Clothes
  Other
}

model Order {
  id          String   @id @default(cuid())
  orderNumber String   @unique
  status      OrderStatus @default(Pending)
  totalAmount Int

  residentId  String
  resident    Resident @relation(fields: [residentId], references: [id])

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  shippingAddress String?
  notes           String?  @db.Text

  orderItems  OrderItem[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([residentId])
  @@index([status])
}

enum OrderStatus {
  Pending
  Processing
  Shipped
  Delivered
  Cancelled
}

model OrderItem {
  id        String   @id @default(cuid())
  quantity  Int
  price     Int
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}
